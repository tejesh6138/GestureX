# GestureX Backend Environment Configuration (Render Web Service + Neon PostgreSQL)

# Django Core
DJANGO_SECRET_KEY=django-insecure-gesturex-production-secret-seed-replace-in-render
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,gesturex-backend.onrender.com,*.onrender.com

# Neon PostgreSQL Database Connection String
# Get this from your Neon Console (neon.tech) -> Connection Details -> Pooled connection
# Required format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-gesturex-cyber-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS & CSRF Settings
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,https://gesturex.onrender.com,https://*.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://gesturex.onrender.com,https://*.onrender.com

# SMTP Email Delivery (Gmail / SendGrid / Brevo / Resend / AWS SES)
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_digit_app_password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=GestureX Security <noreply@gesturex.com>
# Set to True only for local offline development without SMTP:
USE_CONSOLE_EMAIL=False

# OTP Expiration and Throttling
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# JWT Token Lifetimes
JWT_ACCESS_MINUTES=45
JWT_REFRESH_DAYS=14

# Frontend URL
FRONTEND_URL=https://gesturex.onrender.com
